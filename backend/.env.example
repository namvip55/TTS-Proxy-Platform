# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Supabase Credentials (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
# IMPORTANT: backend needs the secret service_role key to bypass RLS for admin DB & verify keys
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# Optional: Supabase JWT secret if verifying JWT locally
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Worker Shared Secret Authentication Key
WORKER_SECRET_KEY=secret_colab_worker_token_change_me_in_prod

# CORS Settings (JSON string array)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://your-frontend.vercel.app"]
