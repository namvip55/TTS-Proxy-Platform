# Địa chỉ Backend FastAPI Gateway (Domain công khai của Gateway hoặc ngrok/localtunnel)
GATEWAY_URL=wss://your-backend-gateway.com
# Khóa bí mật kết nối Worker (phải khớp với WORKER_SECRET_KEY bên backend/.env)
WORKER_SECRET_KEY=vieneu_worker_secret_2026

# Thông tin Supabase để Worker upload trực tiếp audio lên bucket tts-audios
SUPABASE_URL=https://your-project.supabase.co
# Nên dùng Service Role Key hoặc Anon Key có quyền insert vào bucket tts-audios
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_BUCKET=tts-audios
